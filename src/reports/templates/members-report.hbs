<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Members Report</title>
  <style>
    body {
      font-family: Segoe UI, Tahoma, sans-serif;
      margin: 24px;
      color: #1f2937;
    }
    h1 {
      margin-bottom: 4px;
    }
    .meta {
      margin-bottom: 16px;
      color: #4b5563;
      font-size: 14px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    th,
    td {
      border: 1px solid #d1d5db;
      padding: 8px;
      text-align: left;
      font-size: 14px;
    }
    th {
      background-color: #f3f4f6;
    }
  </style>
</head>
<body>
  <h1>Members Report</h1>
  <div class="meta">Generated at: {{generatedAt}}</div>
  <div class="meta">Total member: {{total}}</div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Created At</th>
      </tr>
    </thead>
    <tbody>
      {{#if members.length}}
        {{#each members}}
          <tr>
            <td>{{this.id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.createdAt}}</td>
          </tr>
        {{/each}}
      {{else}}
        <tr>
          <td colspan="4">No data available</td>
        </tr>
      {{/if}}
    </tbody>
  </table>
</body>
</html>
