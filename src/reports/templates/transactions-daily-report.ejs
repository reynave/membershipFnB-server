<div class="report-transactions-daily">
  <h1 class="fw-bold mb-3"><%= title %></h1>

  <div class="meta mb-2">
    <span class="badge bg-light text-dark border me-2">Generated at: <%= meta.generatedAt %></span>
    <span class="badge bg-light text-dark border me-2">Total days: <%= meta.total %></span>
    <span class="badge bg-light text-dark border me-2">Start: <%= filters.dateFrom || '-' %></span>
    <span class="badge bg-light text-dark border">End: <%= filters.dateTo || '-' %></span>
  </div>

  <div class="table-responsive mb-3">
    <table class="table table-bordered table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Date</th>
          <th>Transactions</th>
          <th>Total Amount</th>
            <th>Total Redeem</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length > 0) { %>
          <% rows.forEach((row) => { %>
            <tr>
              <td> <%= new Date(row.date).toISOString().split('T')[0] %></td>
              <td><%= row.count %></td>
              <td><%= row.totalAmount.toLocaleString('id-ID' ) %></td>
              <td><%= row.totalRedeem.toLocaleString('id-ID' ) %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4">No data available</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="summary bg-light p-3 rounded border">
    <div class="fw-semibold mb-1">Summary</div>
    <div>Total Transactions: <strong><%= summary.totalCount %></strong></div>
    <div>Total Amount: <strong><%= summary.totalAmount.toLocaleString('id-ID' ) %></strong></div>
    <div>Total Redeem: <strong><%= summary.totalRedeem.toLocaleString('id-ID' ) %></strong></div>    
  </div>
</div>
