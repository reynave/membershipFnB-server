      "url": "https://api.membership.local",
      "description": "Production Server"
    }
  ],
  "basePath": "/",
  "tags": [
    {
      "name": "Membership",
      "description": "Endpoint health check dan informasi umum Membership"
    },
    {
      "name": "Authentication",
      "description": "Endpoint registrasi dan login member"
    },
    {
